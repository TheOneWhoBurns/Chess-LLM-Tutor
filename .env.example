# Export these in your shell; the application does not auto-load .env.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Required with DJANGO_DEBUG=0:
# DJANGO_SECRET_KEY=replace-with-a-random-secret
# Optional strong evaluator:
# NEMESIS_UCI_ENGINE=/absolute/path/to/stockfish
# Optional lc0 weights:
# NEMESIS_UCI_WEIGHTS=/absolute/path/to/maia-1100.pb.gz
# Optional database override:
# NEMESIS_DB=/absolute/path/to/nemesis.sqlite3
