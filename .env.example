# Export in your shell. This file is not automatically loaded.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Required outside local development:
# DJANGO_SECRET_KEY=replace-with-a-random-secret
# Optional engine paths (defaults use the project runtime and LC0 on PATH):
# NEMESIS_STOCKFISH=/absolute/path/to/stockfish
# NEMESIS_LC0_ENGINE=/absolute/path/to/lc0
# NEMESIS_MAIA_WEIGHTS=/absolute/path/to/maia-1500.pb.gz
# NEMESIS_MAIA_BACKEND=blas
# NEMESIS_DB=/absolute/path/to/nemesis.sqlite3
